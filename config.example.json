{
  "host": "auto",
  "port": 8787,
  "projectDir": "/home/pi/my-project",
  "promptFile": "/home/pi/my-project/prompt.md",
  "editableFiles": [
    {
      "label": "Job prompt",
      "path": "prompt.md"
    },
    {
      "label": "Project rules",
      "path": "CLAUDE.md"
    },
    {
      "label": "About me",
      "path": "profile.md",
      "group": "Profile"
    }
  ],
  "mcpConfig": null,
  "allowedTools": "Read,Write,Edit,Glob,Grep,Bash(node *)",
  "model": null,
  "timeout": "90m",
  "envFile": null,
  "runsDir": "./runs",
  "mail": {
    "to": "you@example.com",
    "from": null,
    "command": "msmtp -t"
  },
  "presets": [
    "run the daily job"
  ],
  "pasteAction": {
    "label": "Evaluate this JD",
    "promptFile": "analyze-prompt.md",
    "request": "Evaluate the pasted job description"
  },
  "items": {
    "label": "Results"
  },
  "itemActions": [
    {
      "id": "done",
      "type": "command",
      "label": "Mark done",
      "doneLabel": "Done ✓",
      "askNote": true,
      "command": [
        "node",
        "scripts/mark-done.mjs"
      ]
    },
    {
      "id": "analyze",
      "type": "job",
      "label": "Analyze",
      "runningLabel": "Analyzing…",
      "doneLabel": "Analyzed",
      "promptFile": "analyze-prompt.md",
      "request": "Analyze this item: {title} — {url}"
    }
  ]
}
